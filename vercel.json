{
  "cleanUrls": true,
  "functions": {
    "api/leads.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/leads", "destination": "/api/leads" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/emails", "destination": "/overall_emails.html" },
    { "source": "/icp1", "destination": "/icp1.html" },
    { "source": "/icp2", "destination": "/icp2.html" },
    { "source": "/icp3", "destination": "/icp3.html" },
    { "source": "/leadgen", "destination": "/lead_gen.html" },
    { "source": "/lead-gen", "destination": "/lead_gen.html" },
    { "source": "/dashboard", "destination": "/overall_emails.html" }
  ]
}
